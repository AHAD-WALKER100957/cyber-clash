# Required for real, persistent, shared storage on Vercel.
# Create a free Redis database at https://console.upstash.com (takes ~1 min),
# then copy the REST URL and REST TOKEN it gives you into these two vars
# (both locally in .env.local, and in your Vercel Project Settings > Environment Variables).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
